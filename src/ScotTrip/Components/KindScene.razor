@* Piccolo pannello illustrato che dà a ogni tipo di tappa il suo carattere. *@
@using ScotTrip.Models

<div class="kind-scene kind-@Kind.ToString().ToLowerInvariant()">
    @switch (Kind)
    {
        case StopKind.Castle:
            <svg viewBox="0 0 360 96" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
                <ellipse cx="60" cy="20" rx="26" ry="8" fill="#fff" opacity=".7" />
                <path d="M0 74 Q120 46 240 66 Q310 76 360 62 L360 96 L0 96 Z" fill="#B9C6D2" />
                <g fill="#22384E">
                    <rect x="252" y="30" width="11" height="40" />
                    <rect x="287" y="30" width="11" height="40" />
                    <rect x="261" y="42" width="28" height="28" />
                    <path d="M251 30 h13 v-6 h-4 v3.5 h-2.5 v-3.5 h-3.5 v3.5 h-3 Z M286 30 h13 v-6 h-4 v3.5 h-2.5 v-3.5 h-3.5 v3.5 h-3 Z" />
                    <rect x="271" y="52" width="8" height="18" fill="#B9C6D2" rx="4" />
                </g>
                <line x1="257.5" y1="24" x2="257.5" y2="12" stroke="#22384E" stroke-width="2" />
                <path d="M257.5 12 h13 l-4 4 4 4 h-13 Z" fill="#7A5F9E" />
                <path d="M0 86 Q140 72 360 84 L360 96 L0 96 Z" fill="#8FA3B5" />
            </svg>
            break;
        case StopKind.Nature:
            <svg viewBox="0 0 360 96" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
                <path d="M0 70 L70 26 L140 70 Z" fill="#7FA08C" />
                <path d="M90 70 L170 18 L250 70 Z" fill="#5B8570" />
                <path d="M166 34 q4 18 -3 36 h10 q6 -18 1 -36 Z" fill="#DDEBEA" />
                <path d="M0 96 L0 78 Q120 62 240 76 Q310 84 360 74 L360 96 Z" fill="#3E6A54" />
                <g fill="#2E5B4E">
                    <path d="M292 74 l9 -22 l9 22 Z" />
                    <rect x="299" y="74" width="4" height="8" />
                    <path d="M318 76 l7 -17 l7 17 Z" />
                    <rect x="323.5" y="76" width="3.5" height="7" />
                </g>
                <path d="M46 82 L46 66 M46 72 Q40 71 39 65" stroke="#2E5B4E" stroke-width="2.6" fill="none" stroke-linecap="round" />
                <path d="M42.5 64 Q42 60 44 58 L46 60 L48 58 Q50 60 49.5 64 Z" fill="#2E5B4E" />
                <path d="M46 62 L46 54 M43 62 L41.5 56 M49 62 L50.5 56" stroke="#8A6FA8" stroke-width="2.6" fill="none" stroke-linecap="round" />
            </svg>
            break;
        case StopKind.Beach:
            <svg viewBox="0 0 360 96" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
                <circle cx="304" cy="26" r="14" fill="#EAD48E" />
                <path d="M60 30 q6 -7 12 0 M74 34 q5 -6 10 0" stroke="#8FA3B5" stroke-width="2.4" fill="none" stroke-linecap="round" />
                <path d="M0 64 Q90 54 180 62 Q270 70 360 58 L360 96 L0 96 Z" fill="#A8CDD3" />
                <path d="M0 72 Q60 66 120 71 Q180 76 240 70 Q300 65 360 70 L360 96 L0 96 Z" fill="#7FB2BC" />
                <path d="M0 96 L0 84 Q120 76 240 84 Q310 88 360 82 L360 96 Z" fill="#EFE3C4" />
                <path d="M14 76 q4 3 8 0 M30 79 q4 3 8 0 M48 76 q4 3 8 0" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round" opacity=".8" />
                <g transform="translate(300 84)">
                    <path d="M0 0 q5 -8 10 0 q-5 3 -10 0 Z" fill="#D9A8A0" />
                    <path d="M2 -1 q3 -4 6 0" stroke="#B67F76" stroke-width="1.4" fill="none" />
                </g>
            </svg>
            break;
        case StopKind.Distillery:
            <svg viewBox="0 0 360 96" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
                <path d="M0 96 L0 80 Q180 70 360 80 L360 96 Z" fill="#D9C39A" />
                <g>
                    <path d="M252 78 q-16 -2 -16 -20 q0 -16 14 -18 l0 -8 q0 -5 8 -5 q8 0 8 5 l0 8 q14 2 14 18 q0 18 -16 20 Z" fill="#C88A4E" />
                    <path d="M266 34 q14 4 18 16" stroke="#C88A4E" stroke-width="5" fill="none" stroke-linecap="round" />
                </g>
                <g fill="#8A5A33">
                    <rect x="60" y="46" width="34" height="32" rx="7" />
                    <rect x="104" y="52" width="28" height="26" rx="6" />
                </g>
                <path d="M60 56 h34 M60 68 h34 M104 60 h28 M104 70 h28" stroke="#6E4526" stroke-width="2.4" />
                <g>
                    <path d="M172 78 v-16 q0 -4 4 -4 h10 q4 0 4 4 v16 Z" fill="#E8C05A" opacity=".85" />
                    <rect x="169" y="76" width="24" height="4" rx="2" fill="#9A6B2F" />
                </g>
                <path d="M310 62 q3 -8 0 -14 M320 60 q3 -7 0 -12" stroke="#B9AA8C" stroke-width="2.4" fill="none" stroke-linecap="round" opacity=".8" />
            </svg>
            break;
        case StopKind.Church:
            <svg viewBox="0 0 360 96" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
                <path d="M0 96 L0 82 Q180 72 360 82 L360 96 Z" fill="#C9C2D6" />
                <g fill="#6A5490">
                    <path d="M262 82 v-34 l14 -14 l14 14 v34 Z" />
                    <path d="M276 22 v8 M272 26 h8" stroke="#6A5490" stroke-width="2.6" />
                    <path d="M271 82 v-20 q5 -7 10 0 v20 Z" fill="#C9C2D6" />
                </g>
                <g fill="none" stroke="#6A5490" stroke-width="3">
                    <path d="M84 82 v-26 q10 -14 20 0 v26" />
                    <path d="M94 82 v-38" stroke-width="2" />
                    <circle cx="94" cy="46" r="4" />
                </g>
                <path d="M150 82 v-18 q7 -9 14 0 v18 Z" fill="#9B8CBC" opacity=".7" />
            </svg>
            break;
        case StopKind.Viewpoint:
            <svg viewBox="0 0 360 96" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
                <circle cx="70" cy="30" r="15" fill="#E8C05A" />
                <g stroke="#E8C05A" stroke-width="3" stroke-linecap="round">
                    <path d="M70 8 v-2 M70 54 v-2 M48 30 h-2 M94 30 h-2 M54 14 l-1.5 -1.5 M87.5 46.5 l-1.5 -1.5 M86 14 l1.5 -1.5 M52.5 46.5 l-1.5 1.5" />
                </g>
                <path d="M120 96 L200 34 L280 96 Z" fill="#8C7B4E" />
                <path d="M186 46 L200 34 L214 46 L206 46 L200 40 L194 46 Z" fill="#F2EFE6" />
                <path d="M240 96 L310 46 L360 82 L360 96 Z" fill="#A6935F" />
                <path d="M0 96 L0 88 Q180 80 360 90 L360 96 Z" fill="#7C8F6E" />
            </svg>
            break;
        case StopKind.Village:
            <svg viewBox="0 0 360 96" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
                <path d="M0 96 L0 84 Q180 76 360 84 L360 96 Z" fill="#C9B9A4" />
                <g>
                    <rect x="86" y="56" width="34" height="28" fill="#E8E2D4" />
                    <path d="M82 56 L103 42 L124 56 Z" fill="#7A5B43" />
                    <rect x="98" y="68" width="10" height="16" fill="#7A5B43" rx="2" />
                    <rect x="128" y="60" width="30" height="24" fill="#DCD2BE" />
                    <path d="M124 60 L143 48 L162 60 Z" fill="#8C6E54" />
                    <rect x="134" y="66" width="8" height="8" fill="#8C6E54" rx="1.5" />
                    <rect x="230" y="58" width="32" height="26" fill="#E4DCCA" />
                    <path d="M226 58 L246 45 L266 58 Z" fill="#7A5B43" />
                    <rect x="252" y="50" width="5" height="10" fill="#7A5B43" />
                </g>
                <path d="M254 48 q4 -6 1 -11 q5 2 5 8" fill="#C9C2B6" opacity=".85" />
            </svg>
            break;
        case StopKind.City:
            <svg viewBox="0 0 360 96" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
                <path d="M0 96 L0 86 Q180 80 360 86 L360 96 Z" fill="#AEB6BE" />
                <g fill="#4A5560">
                    <rect x="70" y="52" width="20" height="34" />
                    <rect x="96" y="42" width="24" height="44" />
                    <rect x="126" y="58" width="18" height="28" />
                    <rect x="236" y="48" width="22" height="38" />
                    <rect x="264" y="58" width="18" height="28" />
                </g>
                <g fill="#E8ECEF">
                    <rect x="75" y="58" width="4" height="4" /><rect x="83" y="58" width="4" height="4" />
                    <rect x="102" y="48" width="4" height="4" /><rect x="110" y="48" width="4" height="4" />
                    <rect x="102" y="58" width="4" height="4" /><rect x="110" y="58" width="4" height="4" />
                    <rect x="242" y="54" width="4" height="4" /><rect x="250" y="54" width="4" height="4" />
                </g>
                <!-- guglia a corona (St Giles) -->
                <g stroke="#4A5560" stroke-width="3" fill="none" stroke-linecap="round">
                    <path d="M180 86 v-30 M180 42 v14 M168 62 q12 -18 24 0 M172 58 v-8 M188 58 v-8" />
                </g>
            </svg>
            break;
        default:
            <svg viewBox="0 0 360 96" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
                <path d="M0 96 L0 82 Q180 72 360 82 L360 96 Z" fill="#CFC6DA" />
                <g fill="#7A5F9E">
                    <path d="M164 82 q-4 -34 8 -52 q4 -4 8 0 q12 18 8 52 Z" opacity=".9" />
                    <path d="M118 82 q-2 -20 5 -32 q3 -3 6 0 q7 12 5 32 Z" opacity=".6" />
                    <path d="M226 82 q-2 -18 4 -28 q3 -3 6 0 q6 10 4 28 Z" opacity=".6" />
                </g>
                <g fill="#C9A227">
                    <path d="M84 36 l2.5 6 l6 2.5 l-6 2.5 l-2.5 6 l-2.5 -6 l-6 -2.5 l6 -2.5 Z" />
                    <path d="M268 28 l2 4.5 l4.5 2 l-4.5 2 l-2 4.5 l-2 -4.5 l-4.5 -2 l4.5 -2 Z" opacity=".8" />
                </g>
            </svg>
            break;
    }
</div>

@code {
    [Parameter, EditorRequired] public StopKind Kind { get; set; }
}
