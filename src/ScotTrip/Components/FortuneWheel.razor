@* Ruota della fortuna generica: N spicchi, gira e restituisce l'indice scelto. *@
@implements IDisposable

<div class="wheel-wrap">
    <div class="wheel-pointer" aria-hidden="true"></div>
    <div class="wheel @(_spinning ? "spinning" : "")" style="transform: rotate(@_angle.ToString(System.Globalization.CultureInfo.InvariantCulture)deg);">
        <svg viewBox="-110 -110 220 220" aria-hidden="true">
            @for (int i = 0; i < Slices.Count; i++)
            {
                var a0 = i * _step - 90;
                var a1 = (i + 1) * _step - 90;
                <path d="@Arc(a0, a1)" fill="@Color(i)" stroke="#FBFBF7" stroke-width="1.5" />
            }
        </svg>

        @* etichette/facce sopra ogni spicchio *@
        <div class="wheel-labels">
            @for (int i = 0; i < Slices.Count; i++)
            {
                var mid = (i + 0.5) * _step - 90;
                var rad = mid * Math.PI / 180.0;
                // testo vicino al bordo e orientato lungo il raggio; facce più interne
                var r = FaceMode ? 62.0 : 82.0;
                var x = 50 + r * Math.Cos(rad) / 2.0;
                var y = 50 + r * Math.Sin(rad) / 2.0;
                var rot = FaceMode ? 0 : mid; // il testo segue il raggio, la faccia resta dritta
                <div class="wheel-label @(FaceMode ? "face" : "")"
                     style="left:@Pc(x); top:@Pc(y); transform: translate(-50%,-50%) rotate(@(rot.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))deg);">
                    @if (FaceMode && SliceImages is not null && i < SliceImages.Count && SliceImages[i] is not null)
                    {
                        <img src="@SliceImages[i]" alt="@Slices[i]" />
                    }
                    else
                    {
                        <span>@Slices[i]</span>
                    }
                </div>
            }
        </div>
    </div>

    <button type="button" class="wheel-hub" @onclick="Spin" disabled="@_spinning" aria-label="Gira la ruota">
        @(_spinning ? "…" : "GIRA")
    </button>
</div>

@code {
    [Parameter, EditorRequired] public List<string> Slices { get; set; } = [];
    /// <summary>In modalità faccia gli spicchi mostrano immagini invece del testo.</summary>
    [Parameter] public bool FaceMode { get; set; }
    [Parameter] public List<string?>? SliceImages { get; set; }
    [Parameter] public EventCallback<int> OnResult { get; set; }

    private double _angle;
    private double _step;
    private bool _spinning;
    private System.Threading.Timer? _timer;

    private static readonly string[] Palette =
        ["#2F5A4C", "#3E7060", "#7A5F9E", "#C9A227", "#3E7C8A", "#9A6B2F", "#6A5490", "#4A5560", "#B0563E", "#4E7A63"];

    protected override void OnParametersSet()
        => _step = Slices.Count > 0 ? 360.0 / Slices.Count : 360;

    private string Color(int i) => Palette[i % Palette.Length];
    private static string Pc(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private string Arc(double a0, double a1)
    {
        double r = 105;
        var (x0, y0) = Point(a0, r);
        var (x1, y1) = Point(a1, r);
        var large = (a1 - a0) > 180 ? 1 : 0;
        return $"M0 0 L{F(x0)} {F(y0)} A{r} {r} 0 {large} 1 {F(x1)} {F(y1)} Z";
    }

    private static (double, double) Point(double deg, double r)
    {
        var rad = deg * Math.PI / 180.0;
        return (r * Math.Cos(rad), r * Math.Sin(rad));
    }
    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private async Task Spin()
    {
        if (_spinning || Slices.Count == 0) return;
        _spinning = true;

        var rnd = new Random();
        var winner = rnd.Next(Slices.Count);

        // portiamo il centro dello spicchio vincente sotto il puntatore (in alto, -90°).
        // il puntatore è a top; lo spicchio i è centrato a (i+0.5)*step - 90 nel sistema ruota.
        var target = (winner + 0.5) * _step;
        var turns = 5 + rnd.Next(3);                 // 5-7 giri pieni per l'effetto
        var current = _angle % 360;
        var final = _angle - current + turns * 360 + (360 - target);
        _angle = final;
        StateHasChanged();

        // durata dell'animazione CSS = 4.2s: al termine notifichiamo il risultato
        _timer?.Dispose();
        var tcs = new TaskCompletionSource();
        _timer = new System.Threading.Timer(_ => tcs.TrySetResult(), null, 4300, System.Threading.Timeout.Infinite);
        await tcs.Task;

        _spinning = false;
        await InvokeAsync(async () =>
        {
            StateHasChanged();
            await OnResult.InvokeAsync(winner);
        });
    }

    public void Dispose() => _timer?.Dispose();
}
