@* Piccoli gatti disegnati in linea: compaiono con parsimonia (stati vuoti, timbro delle curiosità). *@

@if (Pose == CatPose.Stamp)
{
    @* Testa di gatto in un timbro circolare, usata sull'angolo delle carte curiosità *@
    <svg class="@CssClass" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-dasharray="2.5 2.5" />
        <path fill="currentColor" d="M13 15 L11 9 L16 12 Q20 10.5 24 12 L29 9 L27 15 Q30 19 29 24 Q27.5 30 20 30.6 Q12.5 30 11 24 Q10 19 13 15 Z" />
        <circle cx="16.5" cy="20" r="1.3" fill="var(--paper-warm, #F5F2E8)" />
        <circle cx="23.5" cy="20" r="1.3" fill="var(--paper-warm, #F5F2E8)" />
        <path d="M18 24.5 Q20 26 22 24.5" stroke="var(--paper-warm, #F5F2E8)" stroke-width="1.1" fill="none" stroke-linecap="round" />
    </svg>
}
else if (Pose == CatPose.Sleeping)
{
    @* Gatto acciambellato, per gli stati "ancora niente qui" *@
    <svg class="@CssClass" viewBox="0 0 90 60" aria-hidden="true">
        <path fill="currentColor" d="M45 12 Q70 12 74 32 Q76 46 60 50 Q45 53 30 50 Q14 46 16 32 Q20 12 45 12 Z" opacity=".9" />
        <path fill="currentColor" d="M62 14 L60 6 L67 10 Z M28 14 L30 6 L23 10 Z" />
        <path d="M34 30 Q37 32 40 30 M50 30 Q53 32 56 30" stroke="var(--mist, #EDF0EA)" stroke-width="2" fill="none" stroke-linecap="round" />
        <path d="M70 44 Q84 46 80 54 Q76 60 66 54" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
        <text x="76" y="16" font-size="11" fill="currentColor" font-family="var(--font-display)">z</text>
        <text x="82" y="9" font-size="8" fill="currentColor" font-family="var(--font-display)">z</text>
    </svg>
}
else
{
    @* Gatto seduto e incuriosito, con sciarpina: benvenuti e pagine vuote *@
    <svg class="@CssClass" viewBox="0 0 80 100" aria-hidden="true">
        <path fill="currentColor" d="M28 30 L23 14 L34 22 Q40 20 46 22 L57 14 L52 30 Q60 38 58 50 Q56 62 40 63 Q24 62 22 50 Q20 38 28 30 Z" />
        <circle cx="33" cy="42" r="2.6" fill="var(--mist, #EDF0EA)" />
        <circle cx="47" cy="42" r="2.6" fill="var(--mist, #EDF0EA)" />
        <path d="M36 50 Q40 54 44 50" stroke="var(--mist, #EDF0EA)" stroke-width="2" fill="none" stroke-linecap="round" />
        <path fill="currentColor" d="M30 62 Q26 80 30 92 L50 92 Q54 80 50 62 Z" />
        <rect x="27" y="60" width="26" height="7" rx="3.5" fill="var(--heather, #7A5F9E)" />
        <rect x="44" y="64" width="7" height="14" rx="3" fill="var(--heather, #7A5F9E)" />
        <path d="M52 88 Q68 88 64 74" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" />
    </svg>
}

@code {
    [Parameter] public CatPose Pose { get; set; } = CatPose.Curious;
    [Parameter] public string CssClass { get; set; } = "";
}
