@* Piccoli gatti disegnati in linea: compaiono con parsimonia (stati vuoti, timbro delle curiosità). *@

@if (Pose == CatPose.Stamp)
{
    @* Musetto tondo in un timbro circolare, sull'angolo delle carte curiosità *@
    <svg class="@CssClass" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-dasharray="2.5 2.5" />
        <path fill="currentColor" d="M12 16 Q10.5 10 14 8.5 L18 12.5 Q20 12 22 12.5 L26 8.5 Q29.5 10 28 16 Q31 19 30.5 23 Q29.5 30 20 30.5 Q10.5 30 9.5 23 Q9 19 12 16 Z" />
        <ellipse cx="16" cy="20.5" rx="1.7" ry="2.1" fill="var(--paper-warm, #F5F2E8)" />
        <ellipse cx="24" cy="20.5" rx="1.7" ry="2.1" fill="var(--paper-warm, #F5F2E8)" />
        <path d="M18.6 25 Q20 26.4 21.4 25" stroke="var(--paper-warm, #F5F2E8)" stroke-width="1.3" fill="none" stroke-linecap="round" />
    </svg>
}
else if (Pose == CatPose.Sleeping)
{
    @* Gatto acciambellato e felice, per gli stati "ancora niente qui" *@
    <svg class="@CssClass" viewBox="0 0 90 60" aria-hidden="true">
        <ellipse cx="45" cy="36" rx="30" ry="20" fill="currentColor" opacity=".92" />
        <path fill="currentColor" d="M27 22 Q25 13 30 11 L35 17 Z M63 22 Q65 13 60 11 L55 17 Z" />
        <path fill="#E9B7B0" d="M29.5 19 Q28.5 15 31 14 L34 17.5 Z M60.5 19 Q61.5 15 59 14 L56 17.5 Z" opacity=".8" />
        <path d="M33 32 q3.5 3.5 7 0 M50 32 q3.5 3.5 7 0" stroke="var(--mist, #EDF0EA)" stroke-width="2.2" fill="none" stroke-linecap="round" />
        <path d="M43 38.5 Q45 40 47 38.5" stroke="var(--mist, #EDF0EA)" stroke-width="1.8" fill="none" stroke-linecap="round" />
        <path d="M69 46 Q83 48 79 55 Q74 60 64 54" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" />
        <text x="76" y="16" font-size="11" fill="currentColor" font-family="var(--font-display)">z</text>
        <text x="83" y="9" font-size="8" fill="currentColor" font-family="var(--font-display)">z</text>
    </svg>
}
else
{
    @* Gatto seduto e incuriosito, con sciarpina tartan: benvenuti e pagine vuote *@
    <svg class="@CssClass" viewBox="0 0 80 100" aria-hidden="true">
        <path fill="currentColor" d="M26 30 Q23 17 30 14 L37 22 Q40 21 43 22 L50 14 Q57 17 54 30 Q60 35 59.5 43 Q58.5 56 40 56.5 Q21.5 56 20.5 43 Q20 35 26 30 Z" />
        <path fill="#E9B7B0" d="M28.5 26 Q27 19 30.5 17.5 L35.5 23 Z M51.5 26 Q53 19 49.5 17.5 L44.5 23 Z" opacity=".85" />
        <ellipse cx="33" cy="39" rx="3" ry="3.6" fill="#1E3B33" />
        <ellipse cx="47" cy="39" rx="3" ry="3.6" fill="#1E3B33" />
        <circle cx="34" cy="37.6" r="1" fill="#fff" />
        <circle cx="48" cy="37.6" r="1" fill="#fff" />
        <path d="M38.6 44.5 L41.4 44.5 L40 46.4 Z" fill="#E9968C" />
        <path d="M37 48 Q38.5 49.6 40 48 Q41.5 49.6 43 48" stroke="#1E3B33" stroke-width="1.6" fill="none" stroke-linecap="round" />
        <path d="M24 42 L16 40.5 M24 46 L16.5 47 M56 42 L64 40.5 M56 46 L63.5 47" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".65" />
        <path fill="currentColor" d="M29 55 Q24 76 29 91 Q40 94 51 91 Q56 76 51 55 Z" />
        <rect x="26" y="53" width="28" height="8" rx="4" fill="#7A5F9E" />
        <rect x="31.5" y="53" width="2.8" height="8" fill="#5E4880" />
        <rect x="41" y="53" width="2.8" height="8" fill="#5E4880" />
        <rect x="48.5" y="53" width="2" height="8" fill="#C9A227" />
        <rect x="44" y="58" width="8" height="15" rx="4" fill="#7A5F9E" />
        <rect x="44" y="63" width="8" height="2.4" fill="#5E4880" />
        <rect x="44" y="68" width="8" height="2" fill="#C9A227" />
        <path d="M51 88 Q66 88 63 74" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" />
    </svg>
}

@code {
    [Parameter] public CatPose Pose { get; set; } = CatPose.Curious;
    [Parameter] public string CssClass { get; set; } = "";
}
