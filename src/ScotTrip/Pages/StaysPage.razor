@page "/alloggi"
@implements IDisposable
@inject AppInterop Interop

<PageTitle>Alloggi · Scozia</PageTitle>

<h1 class="day-heading">Dove abbiamo dormito</h1>
<p class="day-area">Le camere e i B&amp;B del viaggio.</p>

@if (State.Stays.Count == 0)
{
    <div class="empty-state">
        <CatDoodle Pose="CatPose.Sleeping" />
        <p>Nessun alloggio ancora.<br />Aggiungete il primo con il tasto +.</p>
    </div>
}
else
{
    @foreach (var stay in State.Stays)
    {
        var id = stay.Id.ToString();
        <div class="entry-card">
            <div class="entry-top">
                <h3>@stay.Name</h3>
                <span class="entry-tag">@Nights(stay) nott@(Nights(stay) == 1 ? "e" : "i")</span>
            </div>
            <p class="entry-sub">@stay.Location · @stay.CheckIn.ToString("d MMM") → @stay.CheckOut.ToString("d MMM")</p>
            @if (!string.IsNullOrWhiteSpace(stay.Note))
            {
                <p class="entry-note">"@stay.Note"</p>
            }

            <CategoryChips TargetKind="RatingTarget.Stay" TargetId="@id" />

            <PhotoGallery TargetKind="RatingTarget.Stay" TargetId="@id" />

            <div class="entry-actions">
                <button type="button" class="btn btn-secondary btn-vote" @onclick="() => _rating = stay">★ Vota</button>
                <button type="button" class="icon-btn entry-icon" aria-label="Modifica alloggio" title="Modifica" @onclick="() => OpenEdit(stay)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 20 L4.8 16.2 L16.4 4.6 A1.9 1.9 0 0 1 19.1 4.9 A1.9 1.9 0 0 1 19.4 7.6 L7.8 19.2 Z" /><path d="M14.6 6.4 L17.6 9.4" /></svg></button>
                <button type="button" class="icon-btn entry-icon danger" aria-label="Elimina alloggio" title="Elimina" @onclick="() => DeleteAsync(stay)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4.5 6.5 H19.5 M9.5 6.5 V4.8 A1.3 1.3 0 0 1 10.8 3.5 H13.2 A1.3 1.3 0 0 1 14.5 4.8 V6.5 M6.5 6.5 L7.3 19 A1.5 1.5 0 0 0 8.8 20.4 H15.2 A1.5 1.5 0 0 0 16.7 19 L17.5 6.5 M10 10 V16.5 M14 10 V16.5" /></svg></button>
            </div>
        </div>
    }
}

<button type="button" class="fab" @onclick="OpenNew" aria-label="Aggiungi alloggio">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M12 5 V19 M5 12 H19" stroke-linecap="round" />
    </svg>
</button>

@if (_rating is not null)
{
    <RateSheet TargetKind="RatingTarget.Stay"
               TargetId="@_rating.Id.ToString()"
               Title="@_rating.Name"
               Subtitle="Un voto a testa per ogni categoria."
               OnClose="() => _rating = null" />
}

@if (_editing is not null)
{
    <div class="sheet-backdrop" @ref="_sheetEl" @onclick="CloseSheet">
        <div class="sheet" @onclick:stopPropagation="true">
            <div class="sheet-grip"></div>
            <h2>@(_isNew ? "Nuovo alloggio" : "Modifica alloggio")</h2>

            <div class="form-field">
                <label for="stay-name">Nome</label>
                <input id="stay-name" @bind="_editing.Name" placeholder="Es. Heather View B&B" />
            </div>
            <div class="form-field">
                <label for="stay-location">Località</label>
                <input id="stay-location" @bind="_editing.Location" placeholder="Es. Portree, Isola di Skye" />
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label for="stay-in">Check-in</label>
                    <input id="stay-in" type="date" @bind="_editing.CheckIn" />
                </div>
                <div class="form-field">
                    <label for="stay-out">Check-out</label>
                    <input id="stay-out" type="date" @bind="_editing.CheckOut" />
                </div>
            </div>
            <div class="form-field">
                <label for="stay-note">Nota</label>
                <textarea id="stay-note" rows="2" @bind="_editing.Note" placeholder="Note e ricordi"></textarea>
            </div>

            @if (_error is not null)
            {
                <p class="form-error">@_error</p>
            }

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" @onclick="CloseSheet">Annulla</button>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync">Salva</button>
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _sheetEl;
    private bool _sheetWasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // apre/chiude il "portale" JS quando il foglio compare o sparisce
        var open = _editing is not null;
        if (open && !_sheetWasOpen)
        {
            _sheetWasOpen = true;
            await Interop.OpenSheetAsync(_sheetEl);
        }
        else if (!open && _sheetWasOpen)
        {
            _sheetWasOpen = false;
            await Interop.CloseSheetAsync();
        }
    }

    [Inject] public required TripState State { get; set; }

    private Stay? _editing;
    private Stay? _rating;
    private bool _isNew;
    private string? _error;

    protected override void OnInitialized() => State.Changed += StateHasChanged;

    private static int Nights(Stay stay) => Math.Max(1, stay.CheckOut.DayNumber - stay.CheckIn.DayNumber);

    private void OpenNew()
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        _editing = new Stay { CheckIn = today, CheckOut = today.AddDays(1) };
        _isNew = true;
        _error = null;
    }

    private void OpenEdit(Stay stay)
    {
        _editing = new Stay
        {
            Id = stay.Id, Name = stay.Name, Location = stay.Location,
            CheckIn = stay.CheckIn, CheckOut = stay.CheckOut, Note = stay.Note, UpdatedAt = stay.UpdatedAt
        };
        _isNew = false;
        _error = null;
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _error = "Serve almeno il nome dell'alloggio.";
            return;
        }
        if (_editing.CheckOut <= _editing.CheckIn)
        {
            _error = "Il check-out deve venire dopo il check-in.";
            return;
        }
        _editing.Name = _editing.Name.Trim();
        _editing.Location = _editing.Location?.Trim() ?? "";
        var isNew = _isNew;
        var saved = _editing;
        await State.SaveStayAsync(saved);
        CloseSheet();
        if (isNew) _rating = saved; // appena creato → apriamo subito il voto
    }

    private Task DeleteAsync(Stay stay) => State.DeleteStayAsync(stay);

    private void CloseSheet()
    {
        _editing = null;
        _error = null;
    }

    public void Dispose() => State.Changed -= StateHasChanged;
}
