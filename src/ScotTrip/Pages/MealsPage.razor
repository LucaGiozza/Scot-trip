@page "/pasti"
@implements IDisposable
@inject AppInterop Interop

<PageTitle>Pasti · Scozia</PageTitle>

<h1 class="day-heading">Dove abbiamo mangiato</h1>
<p class="day-area">I ristoranti e i locali del viaggio.</p>

@if (State.Meals.Count == 0)
{
    <div class="empty-state">
        <CatDoodle Pose="CatPose.Sleeping" />
        <p>Nessun pasto ancora.<br />Aggiungete il primo con il tasto +.</p>
    </div>
}
else
{
    @foreach (var group in State.Meals.GroupBy(m => m.DayDate).OrderBy(g => g.Key))
    {
        <h2 class="group-date">@group.Key.ToString("dddd d MMMM")</h2>
        @foreach (var meal in group)
        {
            var id = meal.Id.ToString();
            <div class="entry-card">
                <div class="entry-top">
                    <h3>@meal.Name</h3>
                    <span class="entry-tag">@meal.MealType</span>
                </div>
                <p class="entry-sub">
                    @meal.Place@(meal.Cost is decimal cost ? $" · {cost:0.##} £" : "")
                </p>
                @if (!string.IsNullOrWhiteSpace(meal.Dishes))
                {
                    <p class="entry-dishes">🍽 @meal.Dishes</p>
                }
                @if (!string.IsNullOrWhiteSpace(meal.Note))
                {
                    <p class="entry-note">"@meal.Note"</p>
                }

                <CategoryChips TargetKind="RatingTarget.Meal" TargetId="@id" />

                <PhotoGallery TargetKind="RatingTarget.Meal" TargetId="@id" />

                <div class="entry-actions">
                    <button type="button" class="btn btn-secondary btn-vote" @onclick="() => _rating = meal">★ Vota</button>
                    <button type="button" class="icon-btn entry-icon" aria-label="Modifica pasto" title="Modifica" @onclick="() => OpenEdit(meal)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 20 L4.8 16.2 L16.4 4.6 A1.9 1.9 0 0 1 19.1 4.9 A1.9 1.9 0 0 1 19.4 7.6 L7.8 19.2 Z" /><path d="M14.6 6.4 L17.6 9.4" /></svg></button>
                    <button type="button" class="icon-btn entry-icon danger" aria-label="Elimina pasto" title="Elimina" @onclick="() => DeleteAsync(meal)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4.5 6.5 H19.5 M9.5 6.5 V4.8 A1.3 1.3 0 0 1 10.8 3.5 H13.2 A1.3 1.3 0 0 1 14.5 4.8 V6.5 M6.5 6.5 L7.3 19 A1.5 1.5 0 0 0 8.8 20.4 H15.2 A1.5 1.5 0 0 0 16.7 19 L17.5 6.5 M10 10 V16.5 M14 10 V16.5" /></svg></button>
                </div>
            </div>
        }
    }
}

<button type="button" class="fab" @onclick="OpenNew" aria-label="Aggiungi pasto">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M12 5 V19 M5 12 H19" stroke-linecap="round" />
    </svg>
</button>

@if (_rating is not null)
{
    <RateSheet TargetKind="RatingTarget.Meal"
               TargetId="@_rating.Id.ToString()"
               Title="@_rating.Name"
               Subtitle="Un voto a testa per ogni categoria."
               OnClose="() => _rating = null" />
}

@if (_editing is not null)
{
    <div class="sheet-backdrop" @ref="_sheetEl" @onclick="CloseSheet">
        <div class="sheet" @onclick:stopPropagation="true">
            <div class="sheet-grip"></div>
            <h2>@(_isNew ? "Nuovo pasto" : "Modifica pasto")</h2>

            <div class="form-field">
                <label for="meal-name">Locale</label>
                <input id="meal-name" @bind="_editing.Name" placeholder="Es. The Witchery" />
            </div>
            <div class="form-field">
                <label for="meal-place">Dove</label>
                <input id="meal-place" @bind="_editing.Place" placeholder="Es. Edimburgo, Royal Mile" />
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label for="meal-date">Giorno</label>
                    <input id="meal-date" type="date" @bind="_editing.DayDate" />
                </div>
                <div class="form-field">
                    <label for="meal-type">Pasto</label>
                    <select id="meal-type" @bind="_editing.MealType">
                        <option value="@MealType.Colazione">Colazione</option>
                        <option value="@MealType.Pranzo">Pranzo</option>
                        <option value="@MealType.Cena">Cena</option>
                        <option value="@MealType.Spuntino">Spuntino</option>
                    </select>
                </div>
            </div>
            <div class="form-field">
                <label for="meal-dishes">Cosa abbiamo mangiato</label>
                <input id="meal-dishes" @bind="_editing.Dishes" placeholder="Es. Cullen Skink, fish and chips" />
            </div>
            <div class="form-field">
                <label for="meal-cost">Costo in sterline (facoltativo)</label>
                <input id="meal-cost" type="number" inputmode="decimal" step="0.5" min="0" @bind="_editing.Cost" />
            </div>
            <div class="form-field">
                <label for="meal-note">Nota</label>
                <textarea id="meal-note" rows="2" @bind="_editing.Note" placeholder="Note e ricordi"></textarea>
            </div>

            @if (_error is not null)
            {
                <p class="form-error">@_error</p>
            }

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" @onclick="CloseSheet">Annulla</button>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync">Salva</button>
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _sheetEl;
    private bool _sheetWasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // apre/chiude il "portale" JS quando il foglio compare o sparisce
        var open = _editing is not null;
        if (open && !_sheetWasOpen)
        {
            _sheetWasOpen = true;
            await Interop.OpenSheetAsync(_sheetEl);
        }
        else if (!open && _sheetWasOpen)
        {
            _sheetWasOpen = false;
            await Interop.CloseSheetAsync();
        }
    }

    [Inject] public required TripState State { get; set; }
    [Inject] public required ItineraryService Itinerary { get; set; }

    private Meal? _editing;
    private Meal? _rating;
    private bool _isNew;
    private string? _error;

    protected override void OnInitialized() => State.Changed += StateHasChanged;

    private void OpenNew()
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        var tripDay = Itinerary.CurrentDay(today);
        _editing = new Meal { DayDate = tripDay.Date == default ? today : tripDay.Date };
        _isNew = true;
        _error = null;
    }

    private void OpenEdit(Meal meal)
    {
        // copia di lavoro: se l'utente annulla, l'originale resta intatto
        _editing = new Meal
        {
            Id = meal.Id, Name = meal.Name, Place = meal.Place, DayDate = meal.DayDate,
            MealType = meal.MealType, Cost = meal.Cost, Dishes = meal.Dishes,
            Note = meal.Note, UpdatedAt = meal.UpdatedAt
        };
        _isNew = false;
        _error = null;
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _error = "Serve almeno il nome del locale.";
            return;
        }
        _editing.Name = _editing.Name.Trim();
        _editing.Place = _editing.Place?.Trim() ?? "";
        var isNew = _isNew;
        var saved = _editing;
        await State.SaveMealAsync(saved);
        CloseSheet();
        if (isNew) _rating = saved; // appena creato → apriamo subito il voto
    }

    private Task DeleteAsync(Meal meal) => State.DeleteMealAsync(meal);

    private void CloseSheet()
    {
        _editing = null;
        _error = null;
    }

    public void Dispose() => State.Changed -= StateHasChanged;
}
