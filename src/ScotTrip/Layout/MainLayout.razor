                <path d="M12 8.5 V3 M10 8.7 L9 3.8 M14 8.7 L15 3.8" />
                <path d="M9.2 11.5 Q12 13 14.8 11.5 L14.5 10 L9.5 10 Z" fill="currentColor" stroke="none" />
