        </NavLink>
        <NavLink href="pasti" ActiveClass="active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M7 3 V11 M4.5 3 V7.5 A2.5 2.5 0 0 0 9.5 7.5 V3 M7 11 V21" />
                <path d="M16 3 C14 5 13.5 8 13.5 10.5 H18.5 C18.5 8 18 5 16 3 Z M16 10.5 V21" />
