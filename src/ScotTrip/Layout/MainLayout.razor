@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <div class="header-row">
            <div>
                <div class="app-title">Scozia · il nostro viaggio</div>
                <div class="app-subtitle">4 – 13 settembre 2026</div>
            </div>
            <SyncBadge />
        </div>
    </header>

    <main class="app-main" tabindex="-1">
        @Body
    </main>

    <nav class="tabbar" aria-label="Sezioni">
        <NavLink href="" Match="NavLinkMatch.All" ActiveClass="active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M12 21 C7 15.5 5 12.4 5 9.5 A7 7 0 0 1 19 9.5 C19 12.4 17 15.5 12 21 Z" />
                <circle cx="12" cy="9.5" r="2.4" />
            </svg>
            Itinerario
        </NavLink>
        <NavLink href="pasti" ActiveClass="active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M7 3 V11 M4.5 3 V7.5 A2.5 2.5 0 0 0 9.5 7.5 V3 M7 11 V21" />
                <path d="M16 3 C14 5 13.5 8 13.5 10.5 H18.5 C18.5 8 18 5 16 3 Z M16 10.5 V21" />
            </svg>
            Pasti
        </NavLink>
        <NavLink href="alloggi" ActiveClass="active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M3 11 L12 4 L21 11" />
                <path d="M5.5 10 V20 H18.5 V10" />
                <path d="M9.5 20 V14.5 H14.5 V20" />
            </svg>
            Alloggi
        </NavLink>
        <NavLink href="impostazioni" ActiveClass="active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="3.2" />
                <path d="M12 2.8 V5.5 M12 18.5 V21.2 M2.8 12 H5.5 M18.5 12 H21.2 M5.5 5.5 L7.4 7.4 M16.6 16.6 L18.5 18.5 M18.5 5.5 L16.6 7.4 M7.4 16.6 L5.5 18.5" />
            </svg>
            Altro
        </NavLink>
    </nav>
</div>
